{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Availability (5m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "aegisops:http_requests:availability5m", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Request rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(aegis_http_requests_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "HTTP responses by status",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (status) (rate(aegis_http_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(aegis_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(aegis_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(aegis_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
    },
    {
      "type": "logs",
      "title": "Runtime and application logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{namespace=~\"aegisops-.*|falco\"}", "refId": "A"}],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 14}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["aegisops", "sre", "security"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "title": "AegisOps Service Overview",
  "uid": "aegisops-overview",
  "version": 1
}
